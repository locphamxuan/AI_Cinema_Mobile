# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* variables at build time.
# API of the backend, including /api. Leave empty in development: the emulator, simulator and web
# defaults in src/constants/config.ts apply. Set it for a phone on the LAN or for a release build.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api

# Google Sign-In: the Web client ID (the ID token audience the backend checks) and the iOS client ID.
# Both empty hide the "Continue with Google" button. It needs a development build (eas build --profile
# development); Expo Go has no Google Sign-In module.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
